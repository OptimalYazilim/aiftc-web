# ===========================================================================
# TEST ORTAMI  —  Playwright E2E
# ===========================================================================
# Bu dosya GIT'E GIRMEZ (.gitignore: .env.*). Sablonu .env.test.example'dir.
#
# KURAL: bu dosya GELISTIRME veritabanina ASLA isaret etmemelidir. Testler
# hesap ve kayit olusturup siler; yanlis veritabanina baglanmak gercek
# icerigi yok eder. Asagidaki adres ayri bir veritabanidir (aiftc_test).
# ===========================================================================

NODE_ENV=production

# --- Izole test veritabani -------------------------------------------------
# Ayri bir VERITABANI, ayri bir sema degil: sema izolasyonu Payload'in
# migration'lariyla karismaya musaittir.
DATABASE_URI=postgresql://kullanici:parola@sunucu/aiftc_test?sslmode=require

PAYLOAD_SECRET=test-ortami-icin-rastgele-bir-deger

# --- Uygulama adresi -------------------------------------------------------
NEXT_PUBLIC_SERVER_URL=http://localhost:3100
ALLOWED_ORIGINS=http://localhost:3100

# --- Medya: testte yerel disk ---------------------------------------------
# S3 test kapsaminda degil; yerel disk daha hizli ve baska bir servise
# bagimlilik yaratmaz.
MEDIA_STORAGE_ADAPTER=local

# --- CAPTCHA: Cloudflare'in RESMI test anahtarlari -------------------------
# Koruma AKIS OLARAK calisir (jeton uretilir, sunucu dogrular) ama her zaman
# gecer. Anahtarlari bos birakmak korumayi tamamen kapatirdi ve kayit
# akisinin CAPTCHA'li hali hic sinanmamis olurdu.
#   1x...AA site / 1x...AA gizli  ->  her zaman GECER
CAPTCHA_SITE_KEY=1x00000000000000000000AA
CAPTCHA_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Hiz sinirlama: testte devre disiya yakin ------------------------------
# Uretimde kayit ucu 5 istek / 60 dk. Testler ayni IP'den arka arkaya kosar;
# uretim degeriyle altinci senaryo 429 alir ve test "kirik" gorunur.
RATE_LIMIT_REGISTER_MAX=1000
RATE_LIMIT_REGISTER_WINDOW_MIN=60
RATE_LIMIT_LOGIN_MAX=1000
RATE_LIMIT_LOGIN_WINDOW_MIN=10
RATE_LIMIT_RESET_MAX=1000
RATE_LIMIT_RESET_WINDOW_MIN=60

# --- E-posta: testte SMTP yok ----------------------------------------------
# SMTP_HOST bos oldugunda Payload adaptoru hic kurulmaz ve e-posta konsola
# yazilir. Testler e-posta gonderimini dogrulamaz.
SMTP_HOST=

REVALIDATION_SECRET=test-revalidation

# --- Derleme ciktisi -------------------------------------------------------
# `output: 'standalone'` uretimde zorunludur (Dockerfile onu kopyalar) ama
# traced dosyalari SYMLINK ile kopyalar ve Windows'ta yonetici/gelistirici
# kipi olmadan EPERM verir (olculdu). Testler uretim DAVRANISINI sinar,
# paketleme bicimini degil; bu yuzden standalone testte kapatilir.
# CI (Linux) ve Docker bu degiskeni SET ETMEZ, standalone uretmeye devam eder.
NEXT_BUILD_NO_STANDALONE=true

# Testler ayri bir derleme dizinine derler. Iki sebep:
#  1) Var olan bir .next uzerine yeniden derlemek Windows'ta
#     "Cannot find module for page" (ENOENT) ile cokuyor (olculdu);
#     koşu dizini her seferinde temizler.
#  2) .next silinse gelistirme sunucusunun derlemesi de her kosuda yok olurdu.
# Uretim ve Docker bu degiskeni SET ETMEZ.
NEXT_DIST_DIR=.next-test
