{
  "name": "aiftc-web",
  "version": "0.1.0",
  "private": true,
  "description": "AIFTC (Antalya Uluslararasi Ormancilik Egitim Merkezi) kurumsal web sitesi - EK-1 kapsami",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "next lint",
    "typecheck": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "pnpm payload generate:types",
    "generate:importmap": "pnpm payload generate:importmap",
    "migrate:create": "pnpm payload migrate:create",
    "migrate": "pnpm payload migrate",
    "migrate:status": "pnpm payload migrate:status",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/seed.ts",
    "s3:denetle": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/s3-gizlilik-denetimi.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.0.0",
    "@payloadcms/email-nodemailer": "^3.88.0",
    "@payloadcms/next": "^3.0.0",
    "@payloadcms/plugin-form-builder": "^3.0.0",
    "@payloadcms/plugin-redirects": "^3.0.0",
    "@payloadcms/plugin-search": "^3.0.0",
    "@payloadcms/plugin-seo": "^3.0.0",
    "@payloadcms/richtext-lexical": "^3.0.0",
    "@payloadcms/storage-s3": "^3.0.0",
    "@payloadcms/translations": "^3.0.0",
    "@payloadcms/ui": "^3.0.0",
    "cross-env": "^7.0.3",
    "graphql": "^16.9.0",
    "next": "^15.1.0",
    "next-intl": "^3.26.0",
    "payload": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1124.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
