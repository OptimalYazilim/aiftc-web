# ===========================================================================
# AIFTC — VERİTABANI SUNUCUSU ORTAM DEĞİŞKENLERİ (ŞABLON)
# ===========================================================================
#     cp .env.example .env && chmod 600 .env
# `.env` git'e girmez (.gitignore → .env).
# ===========================================================================

POSTGRES_USER=aiftc
# Uzun ve rastgele olsun. Üretmek için:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# Web sunucusundaki DATABASE_URI'de AYNI parola kullanılır.
POSTGRES_PASSWORD=
POSTGRES_DB=aiftc

# Bu sunucunun (dbaiftc) iç ağ IP adresi. Port yalnızca bu adreste açılır.
DB_BIND_ADDR=

# Yedekleme betiği (yedekle.sh) için — isteğe bağlı:
# YEDEK_DIZINI=/var/backups/aiftc
# YEDEK_SAKLAMA_GUN=14
