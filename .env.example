# ---------------------------------------------------------------------------
# AIFTC Web - Ortam Degiskenleri
# Bu dosyayi `.env` olarak kopyalayin. `.env` ASLA git'e commit edilmez.
# ---------------------------------------------------------------------------

# --- Payload ---------------------------------------------------------------
# openssl rand -base64 32  ile uretin
PAYLOAD_SECRET=degistirin-uzun-rastgele-bir-deger

# --- Veritabani (PostgreSQL / Drizzle) -------------------------------------
# docker-compose ile calisirken host: db, lokal Postgres icin: localhost
DATABASE_URI=postgres://aiftc:aiftc@localhost:5432/aiftc
# Kurumsal Postgres TLS zorunlu ise: true
DATABASE_SSL=false

# --- Uygulama --------------------------------------------------------------
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Prod: https://aiftc.org  (aiftc.com ve aiftc.net 301 ile buraya yonlendirilir)

# CORS / CSRF icin izinli originler (virgulle ayrilir)
ALLOWED_ORIGINS=http://localhost:3000

# --- EK-2: Dijital Kutuphane / Yonetim Portali (baska ekip, subdomain) ------
# Bu adresler CMS'ten de yonetilebilir (Globals > External Services).
# Buradaki degerler yalnizca fallback / build-time default olarak kullanilir.
NEXT_PUBLIC_LIBRARY_URL=https://kutuphane.aiftc.org
NEXT_PUBLIC_PORTAL_URL=https://portal.aiftc.org

# --- Medya depolama --------------------------------------------------------
# local | s3
MEDIA_STORAGE_ADAPTER=local

# MEDIA_STORAGE_ADAPTER=s3 ise doldurun (MinIO da desteklenir)
S3_BUCKET=
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true

# Nesne ACL'i: private | none      (public-read KABUL EDILMEZ, uygulama baslamaz)
#   private -> her nesne `private` ACL ile yazilir (VARSAYILAN)
#   none    -> ACL basligi hic gonderilmez. AWS'nin "Bucket owner enforced"
#              modundaki kovalar ACL basligi tasiyan PUT isteklerini 400 ile
#              REDDEDER; o kovalarda bu deger 'none' YAPILMALIDIR.
S3_ACL=private

# On imzali (signed) indirme — yalnizca `media` icin, varsayilan kapali.
# Acikken dosya baytlari uygulamadan gecmez; istemci suresi dolan bir S3
# adresine yonlendirilir. `document-files` HICBIR ZAMAN imzali sunulmaz:
# on imzali adres hamiline bir belgedir ve paylasildiginda erisim kurali o
# sure boyunca devre disi kalir.
# ACMADAN ONCE: onundeki CDN/ters vekilin 302 yanitini ONBELLEGE ALMADIGINI
# dogrulayin; alirsa sure dolunca olu adres servis edilir.
S3_SIGNED_DOWNLOADS=false

# --- Yukleme boyutu --------------------------------------------------------
# Kutuphane videolari dogrudan panele yuklenir (harici YouTube/Vimeo yok).
# Bu deger YALNIZCA Payload'in kendi sinniridir; MB cinsinden, varsayilan 512.
MAX_UPLOAD_MB=512
#
# DIKKAT — TERS VEKIL SINIRI KODLA AYARLANAMAZ.
# nginx varsayilani client_max_body_size 1m'dir; ayarlanmazsa 1 MB ustundeki
# her yukleme 413 ile reddedilir ve panelde "beklenmeyen hata" gorunur.
# Dagitimda ilgili sunucu blogu su sekilde guncellenmelidir:
#     client_max_body_size 512m;
#     client_body_timeout  300s;
#     proxy_read_timeout   300s;
# Traefik'te buna karsilik gelen ayar yoktur (sinirsizdir); Cloudflare'in
# ucretsiz planinda istek govdesi 100 MB ile sinirlidir ve YUKSELTILEMEZ —
# bunun ustundeki videolar icin S3'e dogrudan yukleme gerekir.

# --- Bot korumasi: Cloudflare Turnstile ------------------------------------
# Kayit ucundaki (POST /api/users) sahte hesap akisini durdurur.
# Anahtarlar: https://dash.cloudflare.com -> Turnstile -> yeni site
#
# IKISI DE BOSSA koruma KAPALIDIR ve kayit eskisi gibi calisir.
# YALNIZCA BIRI doluysa sistem yanlis calisir; acilista uyari yazilir:
#   yalnizca SECRET -> widget cizilmez, her kayit 400 ile reddedilir
#   yalnizca SITE   -> widget gorunur ama sunucu hicbir sey dogrulamaz
#
# GELISTIRME ICIN Cloudflare'in resmi TEST anahtarlari kullanilabilir
# (hesap gerekmez, her zaman gecer):
#   CAPTCHA_SITE_KEY=1x00000000000000000000AA
#   CAPTCHA_SECRET_KEY=1x0000000000000000000000000000000AA
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# --- Revalidation ----------------------------------------------------------
REVALIDATION_SECRET=degistirin-rastgele-bir-deger

# --- Analitik (KVKK: IP anonimlestirme zorunlu) ----------------------------
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=

# --- KVKK saklama suresi temizligi -----------------------------------------
# Saklama suresi dolmus form gonderimlerini silen ucun paylasilan sirri.
# openssl rand -base64 32  ile uretin.
#
# TANIMLI DEGILSE UC NOKTA CALISMAZ (503 doner). Bilincli bir tercih:
# sirsiz bir dagitimda uc herkese acik olsaydi tum form kayitlari
# disaridan silinebilirdi.
CRON_SECRET=degistirin-rastgele-bir-deger
#
# ZAMANLAYICI KURULMAZSA TEMIZLIK CALISMAZ. Dagitimda gunluk bir gorev
# tanimlanmalidir (ornek: her gece 03:15):
#     15 3 * * *  curl -fsS -X POST \
#       -H "Authorization: Bearer $CRON_SECRET" \
#       https://aiftc.org/api/kvkk/temizlik
#
# Once kuru calisma ile ne silinecegini gorun (GET hicbir sey silmez):
#     curl -H "Authorization: Bearer $CRON_SECRET" \
#       https://aiftc.org/api/kvkk/temizlik

# ===========================================================================
# e-DEVLET KAPISI ENTEGRASYONU
# ===========================================================================
# KUM HAVUZU (SANDBOX) KIPI
# ---------------------------------------------------------------------------
# true olduğunda "e-Devlet ile Giriş Yap" düğmesi, gerçek kapı yerine projenin
# içindeki test ekranına (/[locale]/edevlet-mock) gider. Girilen kimlik
# numarası DOĞRULANMAZ, yalnızca biçimi denetlenir.
#
# ÜRETİMDE ASLA true OLMAMALIDIR. Yine de tek savunma hattı bu değişken
# değildir: kod, bayrağın YANINDA NEXT_PUBLIC_SERVER_URL adresinin de yerel
# (localhost / 127.0.0.1 / *.localhost / *.test) olmasını şart koşar. Bayrak
# yanlışlıkla üretime taşınsa bile gerçek alan adında kum havuzu AÇILMAZ ve
# ilgili uçlar 404 döner. Gerekçe: src/lib/edevlet.ts
NEXT_PUBLIC_EDEVLET_MOCK_MODE=true

# KİMLİK EŞLEŞTİRME TUZU
# ---------------------------------------------------------------------------
# T.C. kimlik numarası VERİTABANINA YAZILMAZ; yalnızca tuzlanmış SHA-256 özeti
# saklanır (users.edevletSubject). Bu tuz o özeti üretir.
#
# DEĞİŞTİRİLİRSE mevcut e-Devlet hesapları TANINAMAZ ve kullanıcılar ikinci bir
# hesap açar. Bu yüzden PAYLOAD_SECRET'ten AYRI tutulur: PAYLOAD_SECRET
# güvenlik gereği döndürülebilir, kimlik eşleştirmesi ondan bağımsız kalmalı.
# Boş bırakılırsa PAYLOAD_SECRET'e düşer; ikisi de yoksa akış hiç başlamaz.
EDEVLET_SUBJECT_SALT=

# GERÇEK KAPI — KURUM BAŞVURUSUYLA GELİR, UYDURULMAZ
# ---------------------------------------------------------------------------
# Dördü birlikte tanımlandığında gerçek kip devreye girmeye çalışır. Değerler
# kurum adına e-Devlet tarafından verilir; dönüş adresi
# (/api/auth/edevlet/callback) kapıya KAYITLI olmak zorundadır.
#
# NOT: gerçek akışın kendisi HENÜZ YAZILMADI — parametre adları ve kapsam
# değerleri kurumun entegrasyon dokümanından doğrulanmadan varsayımla
# yazılmadı. Uç nokta bugün 501 döner (bkz. app/api/auth/edevlet/login).
EDEVLET_AUTHORIZE_URL=
EDEVLET_TOKEN_URL=
EDEVLET_CLIENT_ID=
EDEVLET_CLIENT_SECRET=
