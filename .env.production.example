# ===========================================================================
# AIFTC WEB — URETIM ORTAM DEGISKENLERI (ORNEK)
# ===========================================================================
# Kurulum:
#     cp .env.production.example .env.production
#     chmod 600 .env.production
#     docker compose --env-file .env.production up -d --build
#
# BU DOSYA SABLONDUR — icindeki hicbir deger gercek degildir ve oldugu gibi
# kullanilmamalidir. `.env.production` .gitignore kapsamindadir (`.env.*`).
#
# ---------------------------------------------------------------------------
# DERLEME ANI vs CALISMA ANI — ATLANMASI SIK YAPILAN HATA
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_* ile baslayan degiskenler Next tarafindan ISTEMCI PAKETINE
# GOMULUR. Bunlari sonradan degistirmek IMAJI YENIDEN DERLEMEYI gerektirir;
# yalnizca konteyneri yeniden baslatmak yetmez.
# Digerlerinin tamami calisma aninda okunur.
# ===========================================================================


# --- Payload ---------------------------------------------------------------
# Oturum cerezlerini ve sanal sinif erisim jetonlarini imzalar.
# Uretin:  openssl rand -base64 32
# DEGISTIRILIRSE tum panel oturumlari ve acik sanal sinif jetonlari duser.
PAYLOAD_SECRET=

# --- Veritabani ------------------------------------------------------------
# compose bu uc degerden `db` servisini kurar VE app icin DATABASE_URI'yi
# kendisi uretir (postgres://KULLANICI:PAROLA@db:5432/VERITABANI).
# Bu yuzden DATABASE_URI'yi burada TANIMLAMAYIN.
POSTGRES_USER=aiftc
POSTGRES_PASSWORD=
POSTGRES_DB=aiftc

# Yonetilen bir Postgres (Neon, RDS) kullaniliyorsa: compose'daki `db` ve
# `migrate` servislerinin `environment` satirlarini kaldirin, buraya tam
# baglanti adresini yazin ve `db` servisini calistirmayin.
# DATABASE_URI=postgresql://kullanici:parola@sunucu/veritabani?sslmode=require
DATABASE_SSL=false

# --- Uygulama adresi (DERLEME ANI) -----------------------------------------
NEXT_PUBLIC_SERVER_URL=https://aiftc.org
ALLOWED_ORIGINS=https://aiftc.org

# EK-2 alt alan adlari (DERLEME ANI). CMS'ten de yonetilir; buradakiler yedek.
NEXT_PUBLIC_LIBRARY_URL=https://kutuphane.aiftc.org
NEXT_PUBLIC_PORTAL_URL=https://portal.aiftc.org

# --- Medya depolama: MinIO (S3 uyumlu) -------------------------------------
# local | s3   — uretimde 's3' onerilir: konteyner yeniden olusturuldugunda
# yerel diske yazilan dosyalar birim baglanmazsa kaybolur.
MEDIA_STORAGE_ADAPTER=s3

S3_BUCKET=aiftc-media
S3_REGION=eu-central-1
# Bu ikisi ayni zamanda MinIO'nun root kullanicisi/parolasidir (compose).
# Parola en az 8 karakter olmalidir, yoksa MinIO baslamaz.
S3_ACCESS_KEY_ID=aiftc-minio
S3_SECRET_ACCESS_KEY=
# Compose ici varsayilan: http://minio:9000  (konteynerler arasi ag)
# Harici bir S3 kullaniliyorsa tam adresi yazin, MinIO servisini kaldirin.
S3_ENDPOINT=http://minio:9000
# MinIO yol tabanli adresleme kullanir; AWS S3 icin false yapin.
S3_FORCE_PATH_STYLE=true

# Nesne ACL'i: private | none      (public-read KABUL EDILMEZ, uygulama baslamaz)
# MinIO ACL'leri kabul eder; 'private' birakin.
# GERCEK AWS S3 kullaniyorsaniz ve kova "Bucket owner enforced" modundaysa
# (2023 sonrasi varsayilan) ACL basligi 400 ile reddedilir -> 'none' yapin.
S3_ACL=private

# On imzali indirme yalnizca `media` icin ve varsayilan KAPALI. Kisitli
# belgeler (document-files) her zaman Payload uzerinden, her istekte yeniden
# denetlenerek akar. Gerekce: .env.example
S3_SIGNED_DOWNLOADS=false

# --- Yukleme boyutu --------------------------------------------------------
MAX_UPLOAD_MB=512
# DIKKAT: ters vekil sinirini de yukseltin, yoksa 1 MB ustu yuklemeler 413
# doner (ayrinti icin .env.example icindeki not).

# --- SMTP / e-posta --------------------------------------------------------
# ETKIN. `@payloadcms/email-nodemailer` adaptoru payload.config.ts icinde
# baglidir ve bu degiskenleri okur.
#
# ANAHTAR DAVRANIS: adaptor YALNIZCA `SMTP_HOST` DOLUYKEN kurulur.
#   SMTP_HOST dolu  -> e-postalar gercekten gonderilir
#   SMTP_HOST bos   -> Payload'in konsol davranisina dusulur; e-posta
#                      gonderilmez, govdesi sunucu gunlugune yazilir
# Gelistirme makinesinde SMTP olmadan da uygulama calissin diye boyledir.
# URETIMDE BOS BIRAKMAYIN: parola sifirlama ve hesap onay bildirimi
# kullaniciya ULASMAZ.
#
# SMTP_SECURE: 465 (dogrudan TLS) icin true, 587 (STARTTLS) icin false.
# 587'de true yazmak el sikismayi kilitler.
# SMTP_USER bos birakilirsa `auth` hic gonderilmez — kimlik dogrulamasi
# istemeyen ic aglardaki roleler icin gereklidir.
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Antalya Uluslararasi Ormancilik Egitim Merkezi
SMTP_FROM_ADDRESS=bilgi@aiftc.org

# --- Hiz sinirlama: kimlik uclari ------------------------------------------
# `src/lib/rateLimit.ts` + `src/middleware.ts`.
#
# NEDEN ELDE YAZILDI: Payload 3'te YERLESIK hiz sinirlama YOKTUR. Payload 2'nin
# `rateLimit` config alani 3'te tamamen kaldirilmistir (dogrulandi: payload
# 3.88.0 config tiplerinde hic gecmiyor). Config'e boyle bir nesne yazmak onu
# sessizce yok saydirir ve korunuyormus yanilsamasi uretir.
#
# KORUNAN UCLAR (yalnizca POST):
#   /api/users                   kayit   -> bot spam hesap acamasin
#   /api/users/login             giris   -> Payload'in hesap bazli kilidi
#                                          (maxLoginAttempts) tek IP'den bin ayri
#                                          hesaba birer deneme yapan saldirganda
#                                          tetiklenmez; bu katman IP bazlidir
#   /api/users/forgot-password   sifirlama -> her cagri BIR E-POSTA gonderir
#   /api/users/reset-password    sifirlama -> jeton tahminini yavaslatir
#
# AYRICA: /api/users/reset-password uzerinde PAROLA POLITIKASI da burada
# denetlenir. Payload o islemde parolayi ONCE hash'ler, kancayi sonra cagirir;
# kancaya duz metin hic ulasmaz. Olculdu: kural yalnizca kancadayken
# { password: "123" } istegi 200 donuyordu. Bkz. lib/passwordPolicy.ts
#
# SINIRLARI (abartilmamali):
#   - Sayac BELLEKTEDIR: surec yeniden baslayinca sifirlanir, birden cok
#     ornek calistirilirsa her biri kendi sayacini tutar. Bu kurulumda
#     uygulama tek konteynerde calisir, yani pratikte etkilidir.
#   - IP `x-forwarded-for` basligindan okunur; bu baslik UYDURULABILIR.
#     Yalnizca GUVENILEN bir ters vekil arkasinda anlamlidir ve vekil
#     basligi KENDISI yazmalidir:
#         proxy_set_header X-Forwarded-For $remote_addr;
#   - Ters vekil / WAF sinirlamasinin YERINE GECMEZ, onu tamamlar.
#
# Bos birakilirsa varsayilanlar kullanilir (asagidaki degerler).
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_MIN=60
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_LOGIN_WINDOW_MIN=10

# --- KVKK saklama suresi temizligi -----------------------------------------
# Suresi dolmus form gonderimlerini silen ucun paylasilan sirri.
# Uretin:  openssl rand -base64 32
# TANIMLI DEGILSE UC CALISMAZ (503) — bilincli bir emniyet tercihi.
CRON_SECRET=
#
# ZAMANLAYICI KURULMAZSA TEMIZLIK HIC CALISMAZ. Sunucuda gunluk gorev:
#     15 3 * * *  curl -fsS -X POST \
#       -H "Authorization: Bearer $CRON_SECRET" \
#       https://aiftc.org/api/kvkk/temizlik
# Once kuru calisma ile dogrulayin (GET hicbir sey silmez):
#     curl -H "Authorization: Bearer $CRON_SECRET" \
#       https://aiftc.org/api/kvkk/temizlik

# --- ISR yeniden dogrulama -------------------------------------------------
REVALIDATION_SECRET=

# --- Analitik (KVKK: IP anonimlestirme zorunlu) — DERLEME ANI --------------
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=


# ===========================================================================
# DAGITIM KONTROL LISTESI
# ===========================================================================
#  [ ] PAYLOAD_SECRET, POSTGRES_PASSWORD, S3_SECRET_ACCESS_KEY, CRON_SECRET
#      ve REVALIDATION_SECRET dolduruldu (hicbiri bos degil)
#  [ ] chmod 600 .env.production
#  [ ] Ters vekilde TLS sonlandirma yapilandirildi (uygulama HSTS gonderir;
#      duz HTTP ile yayimlanmamalidir)
#  [ ] nginx: client_max_body_size 512m; client_body_timeout 300s;
#      proxy_read_timeout 300s;
#  [ ] Hiz sinirlama ters vekil / WAF katmaninda tanimlandi. Uygulama
#      katmaninda bir sinirlayici VARDIR (middleware.ts) ama sayaci
#      bellektedir ve x-forwarded-for basligina guvenir; vekil katmani
#      onun YERINE GECMEZ, tamamlar.
#  [ ] Ters vekil X-Forwarded-For basligini KENDISI yaziyor:
#          proxy_set_header X-Forwarded-For $remote_addr;
#  [ ] S3 KOVASI KAPALI OLDUGU OLCULDU:  pnpm s3:denetle
#      Betik kovaya bir sonda yazar ve ayni adrese IMZASIZ istek atar.
#      "KOVA HERKESE ACIK" cikarsa canliya gecilmez: o durumda yuklenen her
#      belge, adresini bilen herkese aciktir ve hicbir uygulama kurali bunu
#      geri alamaz. MinIO'da kova politikasi 'none' olmalidir:
#          mc anonymous set none myminio/aiftc-media
#  [ ] SMTP_HOST dolduruldu — bos ise parola sifirlama e-postasi ULASMAZ
#  [ ] KVKK temizlik gorevi zamanlayiciya eklendi
#  [ ] Postgres birimi (pgdata) icin yedekleme kuruldu
#  [ ] Ilk yonetici hesabi olusturuldu: /admin
#  [ ] Hukuki sayfa metinleri (KVKK aydinlatma, gizlilik) hukuk birimince
#      degistirildi — seed icerigi YER TUTUCUDUR
#  [ ] Temsili stok gorseller kurumun kendi fotograflariyla degistirildi
# ===========================================================================
RATE_LIMIT_RESET_MAX=10
RATE_LIMIT_RESET_WINDOW_MIN=60
